              </type>
            </variable>
            <variable name="Hand">
              <type>
                <BOOL/>
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="Run_Mode0">
              <type>
                <derived name="Run_Mode"/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[Auto := false;
Hand := false;

Run_Mode0 (
    HOA_Hand := HOA_In_Hand,
    HOA_Auto := HOA_In_Auto
);

if Run_Mode0.In_Auto then
  Auto := true;
  
elsif Run_Mode0.In_Hand then
  Hand := true;
  
end_if;]]></xhtml:p>
          </ST>
        </body>
        <documentation>
          <xhtml:p><![CDATA[ ]]></xhtml:p>
        </documentation>
      </pou>
