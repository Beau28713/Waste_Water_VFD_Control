    <pous>
      <pou name="Run_Mode" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="HOA_Hand">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="HOA_Auto">
              <type>
                <BOOL/>
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="In_Off">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="In_Hand">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="In_Auto">
              <type>
                <BOOL/>
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="Mode">
              <type>
                <derived name="HOA_MODE"/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[In_Off := false;
In_Hand := false;
In_Auto := false;

if HOA_Hand and not HOA_Auto then 
  Mode := HOA_HAND;
  In_Hand := true;
elsif HOA_Auto and not HOA_Hand then 
  Mode := HOA_AUTO;
  In_Auto := true;
else
  Mode := HOA_OFF;
  In_Off := true;
end_if;]]></xhtml:p>
          </ST>
        </body>
        <documentation>
          <xhtml:p><![CDATA[ ]]></xhtml:p>
        </documentation>
      </pou>
