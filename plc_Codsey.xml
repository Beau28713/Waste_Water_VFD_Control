          </inputVars>
          <outputVars>
            <variable name="Auto">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="Hand">
              <type>
                <BOOL/>
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="Run_Mode0">
              <type>
                <derived name="Run_Mode"/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"><![CDATA[Auto := false;
Hand := false;

Run_Mode0 (
    HOA_Hand := HOA_In_Hand,
    HOA_Auto := HOA_In_Auto
);

if Run_Mode0.In_Auto then
  Auto := true;
  
elsif Run_Mode0.In_Hand then
  Hand := true;
  
end_if;]]></xhtml>
          </ST>
        </body>
      </pou>
